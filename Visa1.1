<!DOCTYPE html>
<html lang="sr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Auto škola Nova</title>
<link rel="stylesheet" href="Visa1.2.css">
</head>
<body>

<header class="header">
  <div class="logo">AUTO ŠKOLA NOVA</div>
  <nav class="nav">
    <a href="#">Početna</a>
    <a href="#">O nama</a>
    <a href="#">Kategorije</a>
    <a href="#">Testovi</a>
    <a href="#">Cenovnik</a>
    <a href="#">Kontakt</a>
  </nav>
</header>

<section class="hero">
  <div class="form-box">
    <h2>ONLINE UPIS</h2>
    <form>
      <input type="text" placeholder="Ime" />
      <input type="text" placeholder="Prezime" />
      <input type="text" placeholder="Telefon" />
      <input type="text" placeholder="Adresa" />
      <input type="email" placeholder="Email" />
      <textarea placeholder="Dodatne informacije"></textarea>
      <button type="submit">POŠALJI</button>
    </form>
  </div>

  <div class="slider">
    <img src="https://via.placeholder.com/800x400" alt="Auto škola vozila" />
  </div>
</section>

<section class="buttons">
  <div>ONLINE UPIS</div>
  <div>ONLINE TESTOVI</div>
  <div>POSTAVITE PITANJE</div>
  <div>ZAKAŽI ČAS VOŽNJE</div>
</section>

<section class="content">
  <div class="box">
    <h3>CENOVNIK</h3>
    <p>Teorija: 16.000 RSD</p>
    <p>Praktična obuka: 68.000 RSD</p>
    <p>Ispit: 5.000 RSD</p>
  </div>

  <div class="box">
    <h3>KATEGORIJE</h3>
    <p>B kategorija</p>
    <p>A kategorija</p>
    <p>C kategorija</p>
    <p>AM / A1 / A2</p>
  </div>

  <div class="box">
    <h3>SAVET DANA</h3>
    <p>Uvek proveri mrtvi ugao pre skretanja.</p>
  </div>
</section>

<footer class="footer">
  <p>© 2026 Auto škola Nova - Sva prava zadržana</p>
</footer>

</body>
</html>


