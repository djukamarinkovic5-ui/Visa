/* =====================
STYLE.CSS
===================== */

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Arial, sans-serif;
}

body{
  background:#0b3a66;
  color:#fff;
}

.header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:15px 40px;
  background:#fff;
  color:#000;
}

.logo{
  font-weight:bold;
  font-size:20px;
}

.nav a{
  margin:0 10px;
  text-decoration:none;
  color:#000;
  font-weight:500;
}

.hero{
  display:flex;
  gap:20px;
  padding:30px;
}

.form-box{
  background:#fff;
  color:#000;
  padding:20px;
  width:300px;
  border-radius:10px;
}

.form-box input,
.form-box textarea{
  width:100%;
  margin:5px 0;
  padding:8px;
}

.form-box button{
  width:100%;
  padding:10px;
  background:#111;
  color:#fff;
  border:none;
  margin-top:10px;
  cursor:pointer;
}

.slider img{
  width:100%;
  border-radius:10px;
}

.buttons{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
  padding:20px;
}

.buttons div{
  background:#111c2e;
  padding:15px;
  text-align:center;
  border-radius:8px;
  cursor:pointer;
}

.content{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
  padding:30px;
}

.box{
  background:#fff;
  color:#000;
  padding:20px;
  border-radius:10px;
}

.footer{
  text-align:center;
  padding:20px;
  background:#061a2e;
}

/* RESPONSIVE */
@media(max-width:768px){
  .hero{
    flex-direction:column;
  }
  .buttons{
    grid-template-columns:repeat(2,1fr);
  }
  .content{
    grid-template-columns:1fr;
  }
  .nav{
    display:none;
  }
}
